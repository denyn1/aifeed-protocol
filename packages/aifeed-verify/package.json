{
  "name": "@aifeed/verify",
  "version": "1.0.0-draft.1",
  "description": "Verify AIFeed signed declarations and content profiles: manifests (v0.1/v0.2), native AIFeed Markdown, MAKO trust layer, revocations, bundles, delta index, and Content-Digest",
  "license": "MIT",
  "homepage": "https://aifeed.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/denyn1/aifeed-protocol.git",
    "directory": "packages/aifeed-verify"
  },
  "bugs": {
    "url": "https://github.com/denyn1/aifeed-protocol/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./schema/ai-json.v0.1.json": "./schema/ai-json.v0.1.json",
    "./schema/ai-json.v0.2.json": "./schema/ai-json.v0.2.json",
    "./schema/ai-signature.v0.1.json": "./schema/ai-signature.v0.1.json",
    "./schema/ai-signature.v0.2.json": "./schema/ai-signature.v0.2.json",
    "./schema/aimd.v1.json": "./schema/aimd.v1.json",
    "./schema/mako.v0.2.json": "./schema/mako.v0.2.json",
    "./schema/mako-signature.v0.2.json": "./schema/mako-signature.v0.2.json",
    "./schema/mako-index.v0.2.json": "./schema/mako-index.v0.2.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aifeed",
    "ai",
    "trust",
    "ed25519",
    "jcs",
    "revocation",
    "manifest",
    "verification"
  ],
  "publishConfig": {
    "access": "public"
  }
}
