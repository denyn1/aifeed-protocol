# AIFeed content serving for Caddy v2 (files generated by `aifeed site build`).
#
# `aifeed site build --profile both` writes /path.aifeed.md and /path.mako.md
# (plus nested /dir/index.*.md) with .sig sidecars. Agents get the matching file
# with the correct media type; everyone else gets HTML.

example.com {
	root * /var/www/site

	# Manifest, index, and signature sidecars
	@wellknown path /.well-known/*
	header @wellknown Cache-Control "public, max-age=3600, must-revalidate"
	@sidecar path *.sig
	header @sidecar Content-Type application/json

	# AIMD negotiation
	@aimd {
		header Accept *text/aifeed+markdown*
		not path /.well-known/* *.sig *.aifeed.md *.mako.md /llms.txt
	}
	handle @aimd {
		header Content-Type "text/aifeed+markdown; charset=utf-8"
		header Vary Accept
		header X-Aifeed-Profile aimd
		rewrite * {path}.aifeed.md
		try_files {path}.aifeed.md {path}/index.aifeed.md /index.aifeed.md
		file_server
	}

	# MAKO negotiation
	@mako {
		header Accept *text/mako+markdown*
		not path /.well-known/* *.sig *.aifeed.md *.mako.md /llms.txt
	}
	handle @mako {
		header Content-Type "text/mako+markdown; charset=utf-8"
		header Vary Accept
		header X-Aifeed-Profile mako
		rewrite * {path}.mako.md
		try_files {path}.mako.md {path}/index.mako.md /index.mako.md
		file_server
	}

	# Markdown files served directly keep their media type
	@aimd_file path *.aifeed.md
	header @aimd_file Content-Type "text/aifeed+markdown; charset=utf-8"
	header @aimd_file Vary Accept
	@mako_file path *.mako.md
	header @mako_file Content-Type "text/mako+markdown; charset=utf-8"
	header @mako_file Vary Accept

	# HTML (and everything else)
	file_server
}
